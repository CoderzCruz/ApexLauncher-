<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- ============ CENTER COLUMN : YOUR SPACE ============ -->
    <LinearLayout
        android:id="@+id/aurora_main_col"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/aurora_player_col"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/aurora_page_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/noto_sans_bold"
            android:letterSpacing="0.12"
            android:text="@string/aurora_page_title"
            android:textColor="@color/aurora_text_white"
            android:textSize="13sp" />

        <!-- ============ QUICK ACTION CARDS ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- Create instance -->
            <LinearLayout
                android:id="@+id/quick_create_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_quick_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_quick_tile_teal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_quick_create_plus" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/noto_sans_bold"
                        android:singleLine="true"
                        android:text="@string/aurora_quick_create_title"
                        android:textColor="@color/aurora_text_white"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/aurora_quick_create_sub"
                        android:textColor="@color/aurora_text_muted"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Explore content -->
            <LinearLayout
                android:id="@+id/quick_explore_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_quick_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_quick_tile_blue">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_quick_explore_search" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/noto_sans_bold"
                        android:singleLine="true"
                        android:text="@string/aurora_quick_explore_title"
                        android:textColor="@color/aurora_text_white"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/aurora_quick_explore_sub"
                        android:textColor="@color/aurora_text_muted"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Your library -->
            <LinearLayout
                android:id="@+id/quick_library_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_quick_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_quick_tile_purple">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_quick_library_grid" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/noto_sans_bold"
                        android:singleLine="true"
                        android:text="@string/aurora_quick_library_title"
                        android:textColor="@color/aurora_text_white"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/quick_library_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/aurora_quick_library_title"
                        android:textColor="@color/aurora_text_muted"
                        android:textSize="10.5sp"
                        tools:text="3 instance(s)" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ============ ACTIVE WORLD CARD ============ -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/aurora_active_world_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_active_world_card"
            android:clickable="true"
            android:focusable="true"
            android:padding="14dp">

            <TextView
                android:id="@+id/active_world_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/noto_sans_bold"
                android:letterSpacing="0.1"
                android:text="@string/aurora_active_world_label"
                android:textColor="@color/aurora_text_white"
                android:textSize="12.5sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/active_world_sub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/aurora_active_world_sub"
                android:textColor="@color/aurora_text_muted"
                android:textSize="10.5sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/active_world_label" />

            <FrameLayout
                android:id="@+id/active_world_icon_tile"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_world_icon_tile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/active_world_sub">

                <ImageView
                    android:id="@+id/active_world_icon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_grass_block" />
            </FrameLayout>

            <TextView
                android:id="@+id/active_world_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/aurora_default_world_title"
                android:textColor="@color/aurora_text_white"
                android:textSize="19sp"
                android:fontFamily="@font/noto_sans_bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/active_world_icon_tile"
                app:layout_constraintTop_toTopOf="@id/active_world_icon_tile" />

            <TextView
                android:id="@+id/active_world_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Vanilla · Minecraft"
                android:textColor="@color/aurora_text_sub"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/active_world_icon_tile"
                app:layout_constraintTop_toBottomOf="@id/active_world_title" />

            <!-- Glowing mint Play bar -->
            <LinearLayout
                android:id="@+id/play_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_mint_play_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/aurora_hero_more_btn"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_play_solid"
                    android:tint="@color/aurora_mint_ink"
                    tools:ignore="UseAppTint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:fontFamily="@font/noto_sans_bold"
                    android:letterSpacing="0.02"
                    android:text="@string/aurora_play"
                    android:textColor="@color/aurora_mint_ink"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Gear: opens the control hub -->
            <ImageButton
                android:id="@+id/aurora_hero_more_btn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_dark_circle_btn"
                android:contentDescription="@string/mcl_options"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_gear_solid_white"
                app:layout_constraintBottom_toBottomOf="@id/play_button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/play_button" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ============ TASKS CARD ============ -->
        <LinearLayout
            android:id="@+id/tasks_card"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_task_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_task_icon_tile">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_task_clock" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tasks_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/noto_sans_bold"
                    android:singleLine="true"
                    android:text="@string/aurora_tasks_title"
                    android:textColor="@color/aurora_text_white"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/tasks_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/aurora_tasks_idle"
                    android:textColor="@color/aurora_text_muted"
                    android:textSize="10.5sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- ============ RIGHT COLUMN : PLAYER ============ -->
    <LinearLayout
        android:id="@+id/aurora_player_col"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_player_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.245"
        app:layout_constraintWidth_min="180dp">

        <net.kdt.pojavlaunch.dashboard.AuroraPlayerSkinView
            android:id="@+id/player_skin_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_add_account"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_add_account_pill"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/noto_sans_bold"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:text="@string/aurora_add_account"
            android:textColor="@color/aurora_mint_bright"
            android:textSize="11.5sp" />

        <LinearLayout
            android:id="@+id/player_instance_pill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_instance_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="9dp">

            <TextView
                android:id="@+id/player_instance_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/noto_sans_bold"
                android:gravity="center"
                android:singleLine="true"
                android:text="@string/aurora_default_world_title"
                android:textColor="@color/aurora_text_white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/player_instance_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:text="Minecraft"
                android:textColor="@color/aurora_text_muted"
                android:textSize="10.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/player_play_button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_mint_play_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/noto_sans_bold"
                android:letterSpacing="0.04"
                android:text="@string/aurora_play_upper"
                android:textColor="@color/aurora_mint_ink"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="9dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_play_solid"
                android:tint="@color/aurora_mint_ink"
                tools:ignore="UseAppTint" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
