<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- CENTER HERO FEATURED WORLD GLASS CARD -->
    <FrameLayout
        android:id="@+id/aurora_hero_card"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_aurora_glass_card"
        android:padding="4dp"
        app:layout_constraintHorizontal_weight="1.36"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/aurora_right_column"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <net.kdt.pojavlaunch.dashboard.RoundedImageView
            android:id="@+id/aurora_hero_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/hero_echo_peaks"
            app:auroraCornerRadius="17dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_aurora_hero_scrim" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="15dp">

            <!-- Subtle Top-Right Active Version / Profile Selector Pill -->
            <TextView
                android:id="@+id/aurora_hero_version_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_aurora_more_pill"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:singleLine="true"
                android:text="Latest Release ▾"
                android:textColor="@color/aurora_text_white"
                android:textSize="10.5sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- FEATURED WORLD Capsule Badge -->
            <TextView
                android:id="@+id/aurora_hero_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_aurora_badge_pill"
                android:fontFamily="@font/noto_sans_bold"
                android:letterSpacing="0.08"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:singleLine="true"
                android:text="@string/aurora_featured_world_badge"
                android:textAllCaps="true"
                android:textColor="@color/aurora_teal_bright"
                android:textSize="9sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/aurora_hero_title" />

            <!-- Hero World / Profile Title -->
            <TextView
                android:id="@+id/aurora_hero_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/noto_sans_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/aurora_default_world_title"
                android:textColor="@color/aurora_text_white"
                android:textSize="22sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/play_button"
                app:layout_constraintBottom_toTopOf="@+id/aurora_hero_subtitle" />

            <!-- Hero Description Subtitle -->
            <TextView
                android:id="@+id/aurora_hero_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="8dp"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:text="@string/aurora_default_world_desc"
                android:textColor="@color/aurora_text_sub"
                android:textSize="11.5sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/play_button"
                app:layout_constraintBottom_toTopOf="@+id/aurora_hero_more_btn" />

            <!-- Bottom-Left More Options (•••) Glass Pill -->
            <ImageButton
                android:id="@+id/aurora_hero_more_btn"
                android:layout_width="36dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_aurora_more_pill"
                android:contentDescription="@string/mcl_options"
                android:padding="3dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_aurora_more_dots"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Bottom-Right Glowing Cyan-Teal PLAY Button -->
            <LinearLayout
                android:id="@+id/play_button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="132dp"
                android:background="@drawable/bg_aurora_play_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_aurora_play_triangle"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/noto_sans_bold"
                    android:letterSpacing="0.06"
                    android:text="@string/aurora_play_upper"
                    android:textColor="@color/aurora_text_white"
                    android:textSize="14sp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

    <!-- RIGHT STACKED 3-CARD COLUMN -->
    <LinearLayout
        android:id="@+id/aurora_right_column"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintHorizontal_weight="1.0"
        app:layout_constraintStart_toEndOf="@id/aurora_hero_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- CARD 1: Live Clock & Weather Glass Widget -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/aurora_weather_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.05"
            android:background="@drawable/bg_aurora_glass_card"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="13dp"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/aurora_clock_icon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_aurora_clock"
                android:importantForAccessibility="no"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/aurora_clock_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:singleLine="true"
                android:text="04:32 PM"
                android:textColor="#D8E5FF"
                android:textSize="10.5sp"
                app:layout_constraintStart_toEndOf="@id/aurora_clock_icon"
                app:layout_constraintTop_toTopOf="@id/aurora_clock_icon"
                app:layout_constraintBottom_toBottomOf="@id/aurora_clock_icon" />

            <TextView
                android:id="@+id/aurora_temp_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/noto_sans_bold"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="24°C"
                android:textColor="@color/aurora_text_white"
                android:textSize="23sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/aurora_clock_icon"
                app:layout_constraintBottom_toTopOf="@+id/aurora_weather_cond" />

            <TextView
                android:id="@+id/aurora_weather_cond"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Partly Cloudy"
                android:textColor="@color/aurora_text_muted"
                android:textSize="10.5sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/aurora_pin_icon"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageView
                android:id="@+id/aurora_weather_icon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_aurora_weather_partly_cloudy"
                android:importantForAccessibility="no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/aurora_weather_loc" />

            <ImageView
                android:id="@+id/aurora_pin_icon"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginEnd="3dp"
                android:src="@drawable/ic_aurora_pin"
                android:importantForAccessibility="no"
                app:layout_constraintEnd_toStartOf="@id/aurora_weather_loc"
                app:layout_constraintTop_toTopOf="@id/aurora_weather_loc"
                app:layout_constraintBottom_toBottomOf="@id/aurora_weather_loc" />

            <TextView
                android:id="@+id/aurora_weather_loc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="95dp"
                android:singleLine="true"
                android:text="Voxelia"
                android:textColor="@color/aurora_text_sub"
                android:textSize="10.5sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- CARD 2: Recently Played + View All -->
        <LinearLayout
            android:id="@+id/aurora_recent_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.5"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_aurora_glass_card"
            android:orientation="vertical"
            android:paddingHorizontal="13dp"
            android:paddingVertical="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/noto_sans_bold"
                    android:singleLine="true"
                    android:text="@string/aurora_recently_played"
                    android:textColor="@color/aurora_text_white"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/aurora_view_all_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="4dp"
                    android:singleLine="true"
                    android:text="@string/aurora_view_all"
                    android:textColor="@color/aurora_cyan_link"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Recent World Row 1 -->
            <LinearLayout
                android:id="@+id/aurora_recent_row_1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <net.kdt.pojavlaunch.dashboard.RoundedImageView
                    android:id="@+id/aurora_recent_thumb_1"
                    android:layout_width="42dp"
                    android:layout_height="30dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/thumb_skyblock_odyssey"
                    app:auroraCornerRadius="6dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="9dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/aurora_recent_title_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/noto_sans_bold"
                        android:singleLine="true"
                        android:text="Skyblock Odyssey"
                        android:textColor="@color/aurora_text_white"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/aurora_recent_sub_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Last played 2h ago"
                        android:textColor="@color/aurora_text_muted"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/aurora_recent_play_1"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:background="@drawable/bg_aurora_circle_play"
                    android:contentDescription="@string/main_play"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_aurora_play_triangle"
                    android:tint="@color/aurora_teal_bright"
                    tools:ignore="UseAppTint" />
            </LinearLayout>

            <!-- Recent World Row 2 -->
            <LinearLayout
                android:id="@+id/aurora_recent_row_2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="3dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <net.kdt.pojavlaunch.dashboard.RoundedImageView
                    android:id="@+id/aurora_recent_thumb_2"
                    android:layout_width="42dp"
                    android:layout_height="30dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/thumb_caves_cliffs"
                    app:auroraCornerRadius="6dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="9dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/aurora_recent_title_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/noto_sans_bold"
                        android:singleLine="true"
                        android:text="Caves &amp; Cliffs"
                        android:textColor="@color/aurora_text_white"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/aurora_recent_sub_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Last played 1d ago"
                        android:textColor="@color/aurora_text_muted"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/aurora_recent_play_2"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:background="@drawable/bg_aurora_circle_play"
                    android:contentDescription="@string/main_play"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_aurora_play_triangle"
                    android:tint="@color/aurora_teal_bright"
                    tools:ignore="UseAppTint" />
            </LinearLayout>
        </LinearLayout>

        <!-- CARD 3: Live Download / World Files Progress Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/aurora_progress_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.95"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_aurora_glass_card"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp">

            <FrameLayout
                android:id="@+id/aurora_progress_badge"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_aurora_circle_download"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:id="@+id/aurora_progress_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_aurora_download"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <TextView
                android:id="@+id/aurora_progress_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:fontFamily="@font/noto_sans_bold"
                android:singleLine="true"
                android:text="@string/aurora_updating_world_files"
                android:textColor="@color/aurora_text_white"
                android:textSize="11sp"
                app:layout_constraintStart_toEndOf="@id/aurora_progress_badge"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/aurora_progress_bar" />

            <ProgressBar
                android:id="@+id/aurora_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:max="100"
                android:progress="100"
                android:progressDrawable="@drawable/progress_aurora_horizontal"
                app:layout_constraintStart_toEndOf="@id/aurora_progress_badge"
                app:layout_constraintEnd_toStartOf="@+id/aurora_progress_percent"
                app:layout_constraintTop_toBottomOf="@id/aurora_progress_title"
                app:layout_constraintBottom_toTopOf="@+id/aurora_progress_subtitle" />

            <TextView
                android:id="@+id/aurora_progress_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/noto_sans_bold"
                android:singleLine="true"
                android:text="100%"
                android:textColor="@color/aurora_text_white"
                android:textSize="10.5sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/aurora_progress_bar"
                app:layout_constraintBottom_toBottomOf="@id/aurora_progress_bar" />

            <TextView
                android:id="@+id/aurora_progress_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Ready to launch"
                android:textColor="@color/aurora_text_muted"
                android:textSize="9.5sp"
                app:layout_constraintStart_toEndOf="@id/aurora_progress_badge"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/aurora_progress_bar"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
