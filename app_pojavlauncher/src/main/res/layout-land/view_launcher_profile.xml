<?xml version="1.0" encoding="utf-8"?>
<!-- A compact landscape variant keeps the profile and primary action together above the fold. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/launcher_profile_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/launcher_panel"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        style="@style/LauncherSectionHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/launcher_selected_profile" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/launcher_field"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <com.kdt.mcgui.mcVersionSpinner
                android:id="@+id/mc_version_spinner"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:drawableEnd="@drawable/launcher_ic_chevron"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/launcher_text"
                app:drawableEndSize="18dp"
                app:drawableStartIntegerScaling="true"
                app:drawableStartSize="32dp" />
            <ImageButton
                android:id="@+id/edit_profile_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/launcher_rail_button"
                android:contentDescription="@string/launcher_edit_profile"
                android:padding="12dp"
                android:src="@drawable/ic_edit_profile" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/play_button"
            android:layout_width="104dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@drawable/launcher_play_button"
            android:clickable="true"
            android:contentDescription="@string/main_play"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/launcher_ic_play" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/main_play"
                android:textAllCaps="true"
                android:textColor="@color/launcher_on_accent"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
