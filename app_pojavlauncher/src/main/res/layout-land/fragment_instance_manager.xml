<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/inst_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/noto_sans_bold"
                android:text="@string/aurora_inst_title"
                android:textColor="@color/aurora_text_white"
                android:textSize="23sp" />

            <TextView
                android:id="@+id/inst_header_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/aurora_inst_subtitle"
                android:textColor="@color/aurora_text_sub"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_inst_badge">

            <TextView
                android:id="@+id/inst_count_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/noto_sans_bold"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/aurora_text_white"
                android:textSize="14sp" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/inst_folder_btn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_inst_icon_btn"
            android:contentDescription="@string/aurora_inst_open_folder"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_folder"
            android:tint="@color/aurora_text_white"
            tools:ignore="UseAppTint" />

        <LinearLayout
            android:id="@+id/inst_install_btn"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_inst_install"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_add"
                android:tint="@color/aurora_mint_ink"
                tools:ignore="UseAppTint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="@font/noto_sans_bold"
                android:text="@string/aurora_inst_install"
                android:textColor="@color/aurora_mint_ink"
                android:textSize="13.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Instance list column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="9"
            android:background="@drawable/bg_inst_panel"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_aurora_search_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_marginStart="13dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_aurora_search"
                    android:tint="@color/aurora_text_sub"
                    tools:ignore="UseAppTint" />

                <EditText
                    android:id="@+id/inst_search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/aurora_inst_search_hint"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="9dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/aurora_text_white"
                    android:textColorHint="@color/aurora_text_muted"
                    android:textSize="13sp"
                    tools:ignore="Autofill" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/inst_chip_all"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_inst_chip_on"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/noto_sans_bold"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/aurora_inst_chip_all"
                        android:textColor="@color/aurora_mint_ink"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/inst_chip_modpacks"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_inst_chip_off"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/noto_sans_bold"
                        android:gravity="center"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:text="@string/aurora_inst_chip_modpacks"
                        android:textColor="@color/aurora_text_white"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/inst_chip_vanilla"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_inst_chip_off"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/noto_sans_bold"
                        android:gravity="center"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:text="@string/aurora_inst_chip_vanilla"
                        android:textColor="@color/aurora_text_white"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/inst_chip_pinned"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_inst_chip_off"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/noto_sans_bold"
                        android:gravity="center"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:text="@string/aurora_inst_chip_pinned"
                        android:textColor="@color/aurora_text_white"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/inst_installed_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/noto_sans_bold"
                    android:text="@string/aurora_inst_installed"
                    android:textColor="@color/aurora_text_white"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/inst_sort_btn"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_inst_icon_btn"
                    android:contentDescription="@string/aurora_inst_chip_all"
                    android:padding="9dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_filter"
                    android:tint="@color/aurora_text_sub"
                    tools:ignore="UseAppTint" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="9dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/inst_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="4dp"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/inst_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:paddingHorizontal="18dp"
                    android:text="@string/aurora_inst_empty"
                    android:textColor="@color/aurora_text_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Detail column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="11"
            android:background="@drawable/bg_inst_panel"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_inst_tile">

                    <ImageView
                        android:id="@+id/inst_detail_icon"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_grass_block" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/inst_detail_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/noto_sans_bold"
                        android:maxLines="1"
                        android:text="1.12.2"
                        android:textColor="@color/aurora_text_white"
                        android:textSize="25sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/inst_pill_loader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_inst_chip_off"
                            android:paddingStart="11dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="11dp"
                            android:paddingBottom="3dp"
                            android:text="@string/aurora_inst_chip_vanilla"
                            android:textColor="@color/aurora_text_white"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/inst_pill_version"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_inst_chip_off"
                            android:paddingStart="11dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="11dp"
                            android:paddingBottom="3dp"
                            android:text="Minecraft 1.12.2"
                            android:textColor="@color/aurora_text_white"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/inst_pin_btn"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_inst_icon_btn"
                    android:contentDescription="@string/aurora_inst_chip_pinned"
                    android:padding="9dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_inst_heart_outline" />

                <ImageButton
                    android:id="@+id/inst_more_btn"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_inst_icon_btn"
                    android:contentDescription="@string/aurora_inst_options"
                    android:padding="9dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_aurora_more_dots"
                    android:tint="@color/aurora_text_white"
                    tools:ignore="UseAppTint" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/inst_tab_overview"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_inst_tab_on"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/noto_sans_bold"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/aurora_inst_tab_overview"
                        android:textColor="@color/aurora_text_white"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/inst_tab_mods"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_inst_tab_off"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/noto_sans_bold"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/aurora_inst_tab_mods"
                        android:textColor="@color/aurora_text_sub"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/inst_tab_packs"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_inst_tab_off"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/noto_sans_bold"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/aurora_inst_tab_packs"
                        android:textColor="@color/aurora_text_sub"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/inst_tab_worlds"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_inst_tab_off"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/noto_sans_bold"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/aurora_inst_tab_worlds"
                        android:textColor="@color/aurora_text_sub"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/inst_tab_settings"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_inst_tab_off"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/noto_sans_bold"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/aurora_inst_tab_settings"
                        android:textColor="@color/aurora_text_sub"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/inst_tab_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <LinearLayout
                android:id="@+id/inst_play_bar"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_aurora_play_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_aurora_play_triangle_dark" />

                <TextView
                    android:id="@+id/inst_play_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/noto_sans_bold"
                    android:letterSpacing="0.04"
                    android:text="@string/aurora_inst_play"
                    android:textColor="@color/aurora_mint_ink"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/inst_play_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:text="@string/aurora_inst_caption"
                android:textColor="@color/aurora_text_sub"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
