<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aurora_bg_deep">

    <!-- Full-bleed enchanted voxel forest wallpaper -->
    <ImageView
        android:id="@+id/aurora_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_aurora_dashboard" />

    <!-- Deep glaze for glass legibility -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33091011" />

    <!-- Vignette on the left so the icon rail reads crisply -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_rail_vignette" />

    <!-- Safe-inset Dashboard Shell -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/aurora_safe_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="10dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- ===================== LEFT ICON RAIL ===================== -->
        <LinearLayout
            android:id="@+id/aurora_side_rail"
            android:layout_width="58dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_side_rail"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/aurora_brand_logo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_logo_badge"
                android:clickable="true"
                android:contentDescription="@string/aurora_brand_title"
                android:focusable="true"
                android:fontFamily="@font/noto_sans_bold"
                android:gravity="center"
                android:text="A"
                android:textColor="@color/aurora_mint_primary"
                android:textSize="17sp" />

            <View
                android:layout_width="22dp"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="#26FFFFFF" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/aurora_nav_home"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_rail_item_selector"
                        android:clickable="true"
                        android:contentDescription="@string/aurora_nav_home"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/aurora_nav_home_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_rail_home" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/aurora_nav_create"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_rail_item_selector"
                        android:clickable="true"
                        android:contentDescription="@string/aurora_nav_create"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/aurora_nav_create_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_rail_plus" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/aurora_nav_library"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_rail_item_selector"
                        android:clickable="true"
                        android:contentDescription="@string/aurora_nav_library"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/aurora_nav_library_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_rail_grid" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/aurora_nav_explore"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_rail_item_selector"
                        android:clickable="true"
                        android:contentDescription="@string/aurora_nav_explore"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/aurora_nav_explore_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_rail_globe" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/aurora_nav_runtime"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_rail_item_selector"
                        android:clickable="true"
                        android:contentDescription="@string/aurora_nav_java"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/aurora_nav_runtime_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_rail_rocket" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/aurora_nav_install"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_rail_item_selector"
                        android:clickable="true"
                        android:contentDescription="@string/aurora_nav_install"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/aurora_nav_install_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_rail_install" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/aurora_nav_settings"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_rail_item_selector"
                        android:clickable="true"
                        android:contentDescription="@string/aurora_nav_settings"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/aurora_nav_settings_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_rail_gear" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/aurora_nav_accounts"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_rail_item_selector"
                        android:clickable="true"
                        android:contentDescription="@string/aurora_nav_accounts"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/aurora_nav_accounts_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_rail_people" />
                    </FrameLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- ===================== CONTENT AREA ===================== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/aurora_content_root"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/aurora_side_rail"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Compact utility bar (back / search / avatar) — hidden on the Home dashboard -->
            <LinearLayout
                android:id="@+id/aurora_top_bar"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:id="@+id/aurora_back_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_aurora_more_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_back_white" />

                    <TextView
                        android:id="@+id/aurora_back_chip_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="Back"
                        android:textColor="@color/aurora_text_white"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/aurora_search_container"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_aurora_search_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_aurora_search"
                        android:tint="@color/aurora_mint_deep"
                        tools:ignore="UseAppTint" />

                    <EditText
                        android:id="@+id/aurora_search_input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/aurora_search_worlds_hint"
                        android:imeOptions="actionSearch|flagNoExtractUi"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"
                        android:singleLine="true"
                        android:textColor="@color/aurora_text_white"
                        android:textColorHint="@color/aurora_text_muted"
                        android:textSize="12sp"
                        tools:ignore="Autofill" />

                    <ImageButton
                        android:id="@+id/aurora_search_clear"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@android:string/cancel"
                        android:padding="2dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_aurora_close"
                        android:visibility="gone" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/aurora_avatar_container"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_aurora_avatar_ring" />

                    <net.kdt.pojavlaunch.dashboard.RoundedImageView
                        android:id="@+id/aurora_avatar_image"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_gravity="center"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_voxel_avatar_default"
                        app:auroraCircle="true" />

                    <View
                        android:id="@+id/aurora_avatar_status_dot"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_aurora_status_dot" />
                </FrameLayout>
            </LinearLayout>

            <!-- MAIN DYNAMIC DASHBOARD CONTENT CONTAINER -->
            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/container_fragment"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/progress_layout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/aurora_top_bar" />

            <!-- Global ProgressLayout (non-Home screens during background tasks) -->
            <com.kdt.mcgui.ProgressLayout
                android:id="@+id/progress_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
