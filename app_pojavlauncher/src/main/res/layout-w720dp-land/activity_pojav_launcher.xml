<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/launcher_forest" />
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/launcher_scrim"
        android:importantForAccessibility="no" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/launcher_navigation"
            layout="@layout/view_launcher_navigation"
            android:layout_width="64dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/launcher_account_panel"
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/launcher_panel"
            android:orientation="vertical"
            android:padding="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                style="@style/LauncherSectionHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/launcher_account_title" />
            <TextView
                style="@style/LauncherCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/launcher_account_subtitle" />
            <com.kdt.mcgui.mcAccountSpinner
                android:id="@+id/account_spinner"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:dropDownVerticalOffset="54dp"
                android:dropDownWidth="220dp"
                android:popupBackground="@drawable/launcher_popup" />
            <TextView
                android:id="@+id/account_add_button"
                style="@style/LauncherTool"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:drawableStart="@drawable/launcher_ic_add"
                android:text="@string/main_add_account" />
        </LinearLayout>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/container_fragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/progress_layout"
            app:layout_constraintEnd_toStartOf="@id/launcher_account_panel"
            app:layout_constraintStart_toEndOf="@id/launcher_navigation"
            app:layout_constraintTop_toTopOf="parent" />
        <com.kdt.mcgui.ProgressLayout
            android:id="@+id/progress_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/launcher_account_panel"
            app:layout_constraintStart_toEndOf="@id/launcher_navigation" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
