<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_aurora_glass_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header Row with Title & Action Pills -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/worlds_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/noto_sans_bold"
                android:text="@string/aurora_worlds_header"
                android:textColor="@color/aurora_text_white"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/worlds_header_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select any saved world or launcher profile to play or customize"
                android:textColor="@color/aurora_text_muted"
                android:textSize="10.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_worlds_open_folder"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_aurora_more_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="11dp"
            android:text="Open Saves"
            android:textColor="@color/aurora_text_white"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btn_worlds_import_zip"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_aurora_more_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="11dp"
            android:text="@string/aurora_import_world_zip"
            android:textColor="@color/aurora_teal_bright"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btn_worlds_new_profile"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_aurora_play_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/noto_sans_bold"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="+ New Profile"
            android:textColor="@color/aurora_text_white"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/worlds_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:id="@+id/worlds_empty_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/worlds_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No matching worlds or profiles found"
                android:textColor="@color/aurora_text_sub"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/btn_worlds_search_marketplace"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_aurora_more_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Search in Marketplace →"
                android:textColor="@color/aurora_teal_bright"
                android:textSize="11.5sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
