<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/launcher_panel"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView
        style="@style/LauncherSectionHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/launcher_quick_tools" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/open_files_button"
            style="@style/LauncherTool"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/launcher_ic_folder"
            android:text="@string/launcher_tool_files" />
        <TextView
            android:id="@+id/quick_settings_button"
            style="@style/LauncherTool"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:drawableStart="@drawable/launcher_ic_settings"
            android:text="@string/launcher_tool_settings" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/share_logs_button"
            style="@style/LauncherTool"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/launcher_ic_logs"
            android:text="@string/launcher_tool_logs" />
        <TextView
            android:id="@+id/install_jar_button"
            style="@style/LauncherTool"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:drawableStart="@drawable/launcher_ic_jar"
            android:text="@string/launcher_tool_jar" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/news_button"
            style="@style/LauncherTool"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/launcher_ic_globe"
            android:text="@string/mcl_tab_wiki" />
        <TextView
            android:id="@+id/discord_button"
            style="@style/LauncherTool"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:drawableStart="@drawable/launcher_ic_discord"
            android:text="@string/mcl_button_discord" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/gamepad_mapping_button"
            style="@style/LauncherTool"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/launcher_ic_controls"
            android:text="@string/launcher_tool_gamepad" />
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>
