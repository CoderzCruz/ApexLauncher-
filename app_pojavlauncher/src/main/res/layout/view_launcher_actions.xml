<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:clipToPadding="false"
    android:fillViewport="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/create_profile_button"
            android:layout_width="172dp"
            android:layout_height="76dp"
            android:background="@drawable/launcher_action"
            android:clickable="true"
            android:contentDescription="@string/launcher_create_profile_title"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">
            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/launcher_icon_tile"
                android:importantForAccessibility="no"
                android:padding="9dp"
                android:src="@drawable/launcher_ic_add" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/LauncherActionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/launcher_create_profile_title" />
                <TextView
                    style="@style/LauncherActionCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/launcher_create_profile_subtitle" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/explore_modpacks_button"
            android:layout_width="172dp"
            android:layout_height="76dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/launcher_action"
            android:clickable="true"
            android:contentDescription="@string/launcher_explore_modpacks"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">
            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/launcher_icon_tile"
                android:importantForAccessibility="no"
                android:padding="9dp"
                android:src="@drawable/launcher_ic_search" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/LauncherActionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/launcher_explore_modpacks" />
                <TextView
                    style="@style/LauncherActionCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/launcher_explore_modpacks_subtitle" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/custom_control_button"
            android:layout_width="172dp"
            android:layout_height="76dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/launcher_action"
            android:clickable="true"
            android:contentDescription="@string/mcl_option_customcontrol"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">
            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/launcher_icon_tile"
                android:importantForAccessibility="no"
                android:padding="9dp"
                android:src="@drawable/launcher_ic_controls" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/LauncherActionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mcl_option_customcontrol" />
                <TextView
                    style="@style/LauncherActionCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/launcher_controls_subtitle" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</HorizontalScrollView>
