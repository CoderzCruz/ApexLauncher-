<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launcher_tasks_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/launcher_action"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:padding="12dp">
    <ImageView
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/launcher_icon_tile"
        android:importantForAccessibility="no"
        android:padding="9dp"
        android:src="@drawable/launcher_ic_time" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            style="@style/LauncherSectionHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/launcher_tasks_title" />
        <TextView
            android:id="@+id/launcher_task_status"
            style="@style/LauncherCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/launcher_tasks_idle" />
    </LinearLayout>
</LinearLayout>
