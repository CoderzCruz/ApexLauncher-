<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#5938EFD8" />
            <stroke
                android:width="1.2dp"
                android:color="#B366F7EC" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#3326C9C3" />
            <stroke
                android:width="1dp"
                android:color="#7852EDE2" />
        </shape>
    </item>
</selector>
