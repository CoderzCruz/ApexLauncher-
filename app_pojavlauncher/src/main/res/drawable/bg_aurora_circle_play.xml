<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#6600F5D4" />
            <stroke
                android:width="1dp"
                android:color="#CC5EF2E8" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#3300F5D4" />
            <stroke
                android:width="1dp"
                android:color="#6629FFE8" />
        </shape>
    </item>
</selector>
