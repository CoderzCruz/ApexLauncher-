<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#4D7DE8D0" />
            <stroke
                android:width="1dp"
                android:color="#CC7DE8D0" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#267DE8D0" />
            <stroke
                android:width="1dp"
                android:color="#4D7DE8D0" />
        </shape>
    </item>
</selector>
