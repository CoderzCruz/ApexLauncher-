<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="23dp" />
            <gradient
                android:angle="135"
                android:startColor="#7300F5D4"
                android:centerColor="#3867E8F9"
                android:endColor="#590EA5E9"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:left="1.2dp"
        android:top="1.2dp"
        android:right="1.2dp"
        android:bottom="1.2dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="135"
                android:startColor="#E0082038"
                android:centerColor="#E5071B30"
                android:endColor="#EB051322"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
