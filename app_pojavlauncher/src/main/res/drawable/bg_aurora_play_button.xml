<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:startColor="#E634C7BA"
                android:endColor="#E61A8291" />
            <stroke
                android:width="1.5dp"
                android:color="#CC9BFFF6" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#66267885" />
            <stroke
                android:width="1dp"
                android:color="#4D5EF2E8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:startColor="#F256F0DF"
                android:centerColor="#EB2EC7C2"
                android:endColor="#EB1D96A8" />
            <stroke
                android:width="1.4dp"
                android:color="#B89EFFF6" />
        </shape>
    </item>
</selector>
