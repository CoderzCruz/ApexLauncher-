<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:startColor="#A31A2223"
                android:centerColor="#99151C1D"
                android:endColor="#A3111919"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#2BFFFFFF" />
        </shape>
    </item>
</layer-list>
