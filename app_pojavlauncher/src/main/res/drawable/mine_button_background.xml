<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="270"
                android:startColor="#E62DC2B7"
                android:endColor="#E6197B8A" />
            <stroke
                android:width="1.2dp"
                android:color="#CC8AFFF5" />
            <padding
                android:left="14dp"
                android:top="8dp"
                android:right="14dp"
                android:bottom="8dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#4D1E6370" />
            <stroke
                android:width="1dp"
                android:color="#335EF2E8" />
            <padding
                android:left="14dp"
                android:top="8dp"
                android:right="14dp"
                android:bottom="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="270"
                android:startColor="#EB49E6D6"
                android:endColor="#EB1D92A3" />
            <stroke
                android:width="1.2dp"
                android:color="#998AFFF5" />
            <padding
                android:left="14dp"
                android:top="8dp"
                android:right="14dp"
                android:bottom="8dp" />
        </shape>
    </item>
</selector>
