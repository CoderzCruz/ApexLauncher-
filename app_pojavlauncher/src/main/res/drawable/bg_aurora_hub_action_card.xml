<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="0"
                android:startColor="#730C3B54"
                android:endColor="#5E082D44"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#A629FFE8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="0"
                android:startColor="#660A2B42"
                android:centerColor="#54072135"
                android:endColor="#5C09263D"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#475FFBF1" />
        </shape>
    </item>
</selector>
