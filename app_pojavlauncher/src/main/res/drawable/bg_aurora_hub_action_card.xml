<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="0"
                android:startColor="#66224259"
                android:endColor="#52263354"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#995EF2E8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="0"
                android:startColor="#5428354E"
                android:centerColor="#45222D44"
                android:endColor="#4D26314A"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#3DFFFFFF" />
        </shape>
    </item>
</selector>
