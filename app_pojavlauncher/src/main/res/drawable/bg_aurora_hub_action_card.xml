<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="0"
                android:startColor="#8C1B2424"
                android:endColor="#8C141B1C"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#997DE8D0" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="0"
                android:startColor="#8C171F20"
                android:centerColor="#8C131A1B"
                android:endColor="#8C161D1E"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#24FFFFFF" />
        </shape>
    </item>
</selector>
