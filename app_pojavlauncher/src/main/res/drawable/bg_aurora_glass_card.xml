<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="135"
                android:startColor="#B309233B"
                android:centerColor="#BD071B2E"
                android:endColor="#C7051322"
                android:type="linear" />
            <stroke
                android:width="1.1dp"
                android:color="#4567F9E9" />
        </shape>
    </item>
</layer-list>
